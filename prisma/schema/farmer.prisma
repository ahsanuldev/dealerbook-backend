
model Farmer {
  id          String   @id @default(cuid())
  dealerId    String
  dealer      Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  // Optional link to a login account (role = FARMER)
  userId      String?  @unique
  user        User?    @relation("FarmerLogin", fields: [userId], references: [id], onDelete: SetNull)

  name        String
  phone       String
  address     String?
  joinedDate  DateTime @default(now())
  status      Boolean  @default(true)

  // Cached balance for performance (positive = farmer owes dealer)
  // Keep in sync via application logic or DB trigger whenever a transaction is added
  currentBalance Decimal @default(0) @db.Decimal(12, 2)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions Transaction[]

  @@index([dealerId])
  @@index([dealerId, name])
  @@map("farmers")
}
