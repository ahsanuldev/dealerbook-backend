model Dealer {
  id           String   @id @default(cuid())
  businessName String
  ownerName    String
  phone        String
  address      String?
  status       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  farmers      Farmer[]
  items        Item[]
  transactions Transaction[]
  auditLogs    AuditLog[]

  @@map("dealers")
}